# Copie para .env.local e preencha. NUNCA publique o .env.local.

# Senha do painel da loja (/painel)
PAINEL_SENHA=
# Frase longa e aleatória para assinar o login do painel (opcional, recomendado)
PAINEL_SEGREDO=

# Endereço público do site (padrão: https://quero.santtovicio.com.br). Só preencha para trocar.
SITE_PUBLICO=

# Chave Pix que vai nas mensagens de WhatsApp
PIX_CHAVE=

# Origem das entregas (fica só no servidor, nunca aparece para o cliente)
ORIGEM_ENDERECO=
# Taxa = base + R$/km, com mínimo
TAXA_BASE=8
TAXA_POR_KM=0.95
TAXA_MINIMO=12
# Google Maps (Distance Matrix API) para a distância exata. Sem ela, usa a tabela de bairros.
GOOGLE_MAPS_KEY=

# Banco de dados. Sem estas duas, os pedidos ficam em data/pedidos.json (modo teste).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso de pedido novo no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp da loja (com DDD). O cliente manda o comprovante para ele e, com a YCloud, é dele que saem as mensagens automáticas.
WHATSAPP_LOJA=

# WhatsApp automático (ver WHATSAPP.md). Sem a chave, o painel usa o botão de envio manual.
# Padrão: YCloud, mesmo número do app WhatsApp Business. WHATSAPP_TOKEN = chave de API da YCloud.
WHATSAPP_TOKEN=
WHATSAPP_IDIOMA=pt_BR
# Só para ligar direto na Meta (número fora do app): WHATSAPP_PROVEDOR=meta e o ID do número.
WHATSAPP_PROVEDOR=
WHATSAPP_PHONE_ID=
