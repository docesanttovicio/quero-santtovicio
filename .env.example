# Copie para .env.local e preencha. NUNCA publique o .env.local.

# Senha do painel da loja (/painel)
PAINEL_SENHA=
# Frase longa e aleatória para assinar o login do painel (opcional, recomendado)
PAINEL_SEGREDO=

# Endereço público do site, sem barra no final (ex.: https://encomendas.santtovicio.com.br)
SITE_URL=http://localhost:3000

# Chave Pix que vai nas mensagens de WhatsApp
PIX_CHAVE=

# Origem das entregas (fica só no servidor, nunca aparece para o cliente)
ORIGEM_ENDERECO=
# Taxa = base + R$/km, com mínimo
TAXA_BASE=8
TAXA_POR_KM=0.95
TAXA_MINIMO=12
# Google Maps (Distance Matrix API) para a distância exata. Sem ela, usa a tabela de bairros.
GOOGLE_MAPS_KEY=

# Banco de dados. Sem estas duas, os pedidos ficam em data/pedidos.json (modo teste).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso de pedido novo no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp automático (API oficial da Meta). Sem estas duas, o painel usa o botão de envio manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_IDIOMA=pt_BR
